# ---- Build Stage ----
FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /tmp/facturae-engine ./src/cmd/facturae-engine

# ---- Test Stage ----
FROM alpine:latest AS test

RUN apk add --no-cache openssl libxml2-utils tzdata curl jq sqlite bash coreutils

WORKDIR /app
COPY --from=builder /tmp/facturae-engine .
COPY scripts/test-invoice.sh scripts/test-chain.sh scripts/test-chain-verify.sh /app/scripts/
COPY src/testdata/ /app/src/testdata/

EXPOSE 9090

CMD ["/bin/bash"]
