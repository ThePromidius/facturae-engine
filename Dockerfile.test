# ---- Build Stage ----
FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /tmp/facturae-engine ./src/cmd/facturae-engine

# ---- Test Stage (includes Go to run go test, plus all tooling) ----
FROM golang:1.22-alpine AS test

RUN apk add --no-cache openssl libxml2-utils tzdata curl jq sqlite postgresql-client bash coreutils

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
COPY --from=builder /tmp/facturae-engine .
RUN chmod +x scripts/*.sh

EXPOSE 9090

CMD ["/bin/bash"]
