# --- FacturaE Engine Configuration ---

# Server configuration
# Address to listen on. Inside Docker, use 0.0.0.0:8080
ENGINE_SOCKET=0.0.0.0:8080
# Directory where XSD schemas are stored
ENGINE_SCHEMAS=/app/schemas

# Database configuration (Persistence for Verifactu)
# Options: memory, postgres, sqlite
DB_DRIVER=postgres
# Connection string (DSN)
# For Postgres: postgres://user:pass@host:port/dbname?sslmode=disable
DB_DSN=postgres://facturacion:supersecretpassword@postgres-db:5432/verifactu_db?sslmode=disable

# Signing configuration (Certificate)
# Path to the PKCS#12 file (.p12/.pfx) inside the container
CERT_P12_PATH=/app/certs/cert.p12
# Password for the PKCS#12 file
CERT_P12_PASS=your_p12_password

# AEAT configuration
# Options: test, prod (leave empty to disable automatic submission)
AEAT_ENV=test

# --- Infrastructure (PostgreSQL) ---
POSTGRES_USER=facturacion
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=verifactu_db
